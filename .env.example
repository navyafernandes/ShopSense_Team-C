# ================================================================
# ShopSense - Environment Configuration Template (.env.example)
# ================================================================
# Copy this file to .env in your deployment environment or set these
# variables in your cloud hosting provider (Render / Railway / etc.).
# DO NOT COMMIT ACTUAL SECRETS TO PUBLIC REPOSITORIES.
# ================================================================

# --- Database Configuration ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:Postgres%40123@database:5432/shopsense

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgres@123
POSTGRES_DB=shopsense
POSTGRES_PORT=5432

# --- Backend Security & Authentication ---
SECRET_KEY=shopsense_super_secret_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend URLs
# Example for production: https://shopsense.onrender.com,https://shopsense-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost,http://127.0.0.1

# --- Frontend Build Configuration ---
# Public URL of the FastAPI backend (baked into Vite build)
VITE_API_URL=http://localhost:8000

# --- Optional External AI Integrations ---
OPENROUTER_API_KEY=